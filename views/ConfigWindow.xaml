<Window x:Class="GitConfigTool.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="完整配置 - GitConfigTool"
        Icon="pack://application:,,,/assets/icon.ico"
        Height="560" Width="820"
        MinHeight="360" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F3F3">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新列表" Command="{Binding RefreshConfigListCommand}"/>
            <Button Content="保存选中项" Command="{Binding SaveConfigItemCommand}" Style="{StaticResource SuccessButton}"/>
            <Button Content="删除选中项" Command="{Binding DeleteConfigItemCommand}" Style="{StaticResource DangerButton}"/>
            <Button Content="打开配置路径" Command="{Binding OpenGitConfigLocationCommand}" Style="{StaticResource SecondaryButton}"
                    ToolTip="在资源管理器中打开 .gitconfig 所在目录并选中该文件"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ConfigItems}"
                  SelectedItem="{Binding SelectedConfigItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#FFCCCCCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="配置键" Binding="{Binding FullKey}" IsReadOnly="True" Width="260"/>
                <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" IsReadOnly="True" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
