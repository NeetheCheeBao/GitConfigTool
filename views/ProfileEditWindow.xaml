<Window x:Class="GitConfigTool.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑档案"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 档案显示名直接用 Git user.name，不再单独维护"显示用名称" -->
                <TextBlock Text="Git user.name" Margin="0,0,0,4"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Git user.email" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="签名密钥 (user.signingkey)" Margin="0,12,0,4"/>
                <TextBox Text="{Binding SigningKey, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="GPG 密钥 ID 或 SSH 公钥路径"/>

                <TextBlock Text="签名格式 (gpg.format)" Margin="0,12,0,4"/>
                <ComboBox Text="{Binding SigningFormat, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True">
                    <ComboBoxItem>openpgp</ComboBoxItem>
                    <ComboBoxItem>ssh</ComboBoxItem>
                    <ComboBoxItem>x509</ComboBoxItem>
                </ComboBox>

                <CheckBox Content="强制提交签名 (commit.gpgsign)" IsChecked="{Binding CommitGpgsign}" Margin="0,12,0,0"/>
                <CheckBox Content="强制标签签名 (tag.gpgsign)" IsChecked="{Binding TagGpgsign}" Margin="0,8,0,0"/>

                <TextBlock Text="SSH 私钥路径（可选）" Margin="0,12,0,4"/>
                <TextBox Text="{Binding SshKeyPath, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="关联 GitHub 用户名（可选）" Margin="0,12,0,4"/>
                <TextBox Text="{Binding GithubUsername, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="凭据助手 credential.helper（可选）" Margin="0,12,0,4"/>
                <TextBox Text="{Binding CredentialHelper, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="例如 manager-core / store / cache"/>

                <TextBlock Text="HTTPS 后端 http.sslBackend（可选）" Margin="0,12,0,4"/>
                <ComboBox SelectedValue="{Binding SslBackend, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag" IsEditable="True"
                          ToolTip="openssl：Git 自带；schannel：使用 Windows 证书存储。留空表示应用档案时不修改该项">
                    <ComboBoxItem Tag="">（不修改）</ComboBoxItem>
                    <ComboBoxItem Tag="openssl">openssl</ComboBoxItem>
                    <ComboBoxItem Tag="schannel">schannel</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/>
            <Button Content="保存" Width="80" Click="Save_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Grid>
</Window>
