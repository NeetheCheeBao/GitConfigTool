<Window x:Class="GitConfigTool.Views.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource profile.title}"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 档案显示名使用 Git user.name -->
                <TextBlock Text="Git user.name" Margin="0,0,0,4"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Git user.email" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{DynamicResource profile.signing_key}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding SigningKey, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource profile.signing_key_hint}"/>

                <TextBlock Text="{DynamicResource profile.signing_format}" Margin="0,12,0,4"/>
                <ComboBox Text="{Binding SigningFormat, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True">
                    <ComboBoxItem>openpgp</ComboBoxItem>
                    <ComboBoxItem>ssh</ComboBoxItem>
                    <ComboBoxItem>x509</ComboBoxItem>
                </ComboBox>

                <CheckBox Content="{DynamicResource profile.commit_sign}" IsChecked="{Binding CommitGpgsign}" Margin="0,12,0,0"/>
                <CheckBox Content="{DynamicResource profile.tag_sign}" IsChecked="{Binding TagGpgsign}" Margin="0,8,0,0"/>

                <TextBlock Text="{DynamicResource profile.ssh_key_path}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding SshKeyPath, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{DynamicResource profile.github_user}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding GithubUsername, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{DynamicResource profile.credential_helper}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding CredentialHelper, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource profile.credential_helper_hint}"/>

                <TextBlock Text="{DynamicResource profile.ssl_backend}" Margin="0,12,0,4"/>
                <ComboBox SelectedValue="{Binding SslBackend, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag" IsEditable="True"
                          ToolTip="{DynamicResource profile.ssl_backend_hint}">
                    <ComboBoxItem Tag="" Content="{DynamicResource profile.no_change}"/>
                    <ComboBoxItem Tag="openssl">openssl</ComboBoxItem>
                    <ComboBoxItem Tag="schannel">schannel</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource common.cancel}" Width="80" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/>
            <Button Content="{DynamicResource common.save}" Width="80" Click="Save_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Grid>
</Window>
