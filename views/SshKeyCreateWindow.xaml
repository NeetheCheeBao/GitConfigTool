<Window x:Class="GitConfigTool.Views.SshKeyCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ssh.create_key}"
        Height="450" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource keycreate.name}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock FontSize="11" Foreground="#FF888888" Margin="2,3,0,0"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{DynamicResource keycreate.write_to}"/><Run Text="{Binding KeyName, Mode=OneWay}"/>
            </TextBlock>

            <TextBlock Text="{DynamicResource keycreate.algorithm}" Margin="0,12,0,4"/>
            <ComboBox SelectedValue="{Binding KeyType, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag">
                <ComboBoxItem Tag="ed25519" Content="{DynamicResource keycreate.ed25519}"/>
                <ComboBoxItem Tag="rsa">RSA 4096</ComboBoxItem>
                <ComboBoxItem Tag="ecdsa">ECDSA（nistp521）</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="{DynamicResource keycreate.identity}" Margin="0,12,0,4"/>
            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource keycreate.identity_hint}"/>

            <TextBlock Text="{DynamicResource keycreate.passphrase}" Margin="0,12,0,4" Foreground="#FFAAAAAA"/>
            <PasswordBox x:Name="PassphraseBox" IsEnabled="False"
                         Background="#FFEDEDED" BorderBrush="#FFD9D9D9"
                         PasswordChanged="Passphrase_Changed"
                         ToolTipService.ShowOnDisabled="True"
                         ToolTip="{DynamicResource keycreate.passphrase_disabled}"/>

            <!-- 用 TextBlock 承载内容：CheckBox 直接吃字符串时会把 _ 当成访问键，
                 "allowed_signers" 里的下划线会被吃掉并给 s 加下划线 -->
            <CheckBox Margin="0,16,0,0"
                      IsChecked="{Binding AddToAllowedSigners}"
                      ToolTip="{DynamicResource keycreate.whitelist_hint}">
                <TextBlock Text="{DynamicResource keycreate.auto_whitelist}"/>
            </CheckBox>

            <TextBlock Text="{DynamicResource keycreate.whitelist_need_identity}" FontSize="11" Foreground="#FFA32D2D"
                       Margin="2,3,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanAddToAllowedSigners}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource common.cancel}" Width="80" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"/>
            <Button Content="{DynamicResource common.create}" Width="80" Click="Create_Click" Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Grid>
</Window>
