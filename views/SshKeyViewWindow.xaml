<Window x:Class="GitConfigTool.Views.SshKeyViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密钥内容"
        Height="420" Width="1000"
        MinHeight="300" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="私钥" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PathLink}"
                           Text="{Binding PrivatePathDisplay, Mode=OneWay}"
                           Tag="{Binding PrivatePath}"
                           MouseLeftButtonUp="Path_Click" MouseRightButtonUp="Path_RightClick">
                    <TextBlock.ToolTip>
                        <TextBlock>
                            <Run Text="{Binding PrivatePath, Mode=OneWay}"/><LineBreak/>
                            <Run Text="左键定位到文件，右键复制路径" Foreground="#FF888888"/>
                        </TextBlock>
                    </TextBlock.ToolTip>
                </TextBlock>
                <Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                    <TextBox x:Name="PrivateBox"
                             Text="{Binding PrivateText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"/>
                </Border>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="公钥" FontWeight="SemiBold" Margin="0,0,0,4"
                           ToolTip="可以公开，用于上传到代码托管平台"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PathLink}"
                           Text="{Binding PublicPathDisplay, Mode=OneWay}"
                           Tag="{Binding PublicPath}"
                           MouseLeftButtonUp="Path_Click" MouseRightButtonUp="Path_RightClick">
                    <TextBlock.ToolTip>
                        <TextBlock>
                            <Run Text="{Binding PublicPath, Mode=OneWay}"/><LineBreak/>
                            <Run Text="左键定位到文件，右键复制路径" Foreground="#FF888888"/>
                        </TextBlock>
                    </TextBlock.ToolTip>
                </TextBlock>
                <Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4">
                    <TextBox x:Name="PublicBox"
                             Text="{Binding PublicText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"/>
                </Border>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="80" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="SaveButton" Content="校验并保存" Width="110" Click="Save_Click"
                    Style="{StaticResource SuccessButton}"/>
        </StackPanel>
    </Grid>
</Window>
