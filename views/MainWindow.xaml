<Window x:Class="GitConfigTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="pack://application:,,,/assets/icon.ico"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F3F3">

    <Window.Resources>
        <!--
          档案列表的行样式（GitConfig 页与 GitHub CLI 页共用）：
          使用中 = 绿色，选中 = 蓝色，两者叠加 = 金色。
          用自定义模板是为了去掉默认模板里的选中触发器——它的优先级高于样式触发器，
          会导致「使用中」的行一旦被选中就丢掉绿色。
        -->
        <Style x:Key="ProfileListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 使用中 -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#FFE3F5E4"/>
                    <Setter Property="BorderBrush" Value="#FF107C10"/>
                </DataTrigger>
                <!-- 选中 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE5F1FB"/>
                    <Setter Property="BorderBrush" Value="#FF0078D4"/>
                </Trigger>
                <!-- 选中且使用中：金色。放最后，优先级高于上面两条 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}"
                                   Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFAEEDA"/>
                    <Setter Property="BorderBrush" Value="#FFEF9F27"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#FF1E1E2E" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GitConfigTool" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{DynamicResource app.subtitle}" FontSize="14" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LanguageMenuButton" Width="34" Padding="0"
                            ToolTip="{DynamicResource lang.switch_tip}"
                            Click="LanguageMenuButton_Click">
                        <TextBlock Text="🌐" FontSize="16" FontFamily="Segoe UI Emoji"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Content="{DynamicResource main.refresh_all}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <TabControl Grid.Row="1" Margin="12" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">

            <!-- 标签页1：GitConfig -->
            <TabItem Header="GitConfig">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧档案列表 -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{DynamicResource main.new_profile}" Command="{Binding AddProfileCommand}"/>
                            <Button Content="{DynamicResource main.capture_current}" Command="{Binding CaptureCurrentAsProfileCommand}" Style="{StaticResource SecondaryButton}" ToolTip="{DynamicResource tip.capture_current}"/>
                        </StackPanel>
                        <!-- 配置文件路径，左键打开、右键复制 -->
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                   TextTrimming="CharacterEllipsis" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenProfilesJsonFolderCommand}"/>
                                <MouseBinding MouseAction="RightClick" Command="{Binding CopyGitConfigPathCommand}"/>
                            </TextBlock.InputBindings>
                            <TextBlock.ToolTip>
                                <TextBlock>
                                    <Run Text="{Binding GitConfigPath, Mode=OneWay}"/><LineBreak/>
                                    <Run Text="{DynamicResource tip.path_link}" Foreground="#FF888888"/>
                                </TextBlock>
                            </TextBlock.ToolTip>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF888888"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FF0078D4"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{DynamicResource main.config_file}"/><Run Text="{Binding GitConfigPathDisplay, Mode=OneWay}"/>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile}"
                                 BorderThickness="1"
                                 BorderBrush="#FFCCCCCC"
                                 Background="White">
                            <!-- 当前生效的档案用背景色高亮 -->
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="ProfileListItem"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Email}" Foreground="#FF888888" FontSize="11" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- 每个档案的操作按钮 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="{DynamicResource main.apply_profile}"
                                                    Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Padding="10,3" Margin="0,0,6,0" FontSize="12"
                                                    ToolTip="{DynamicResource tip.apply_profile}"/>
                                            <Button Content="{DynamicResource common.edit}"
                                                    Command="{Binding DataContext.EditProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,3" Margin="0,0,6,0" FontSize="12"
                                                    ToolTip="{DynamicResource tip.edit_profile}"/>
                                            <Button Content="{DynamicResource common.delete}"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Padding="10,3" Margin="0" FontSize="12"
                                                    ToolTip="{DynamicResource tip.delete_profile}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 右侧：当前全局配置 + 完整配置 -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="120"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource main.open_config_path}"
                                        Command="{Binding OpenGitConfigLocationCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="12,0,0,0"
                                        ToolTip="{DynamicResource tip.open_config_path}"/>
                                <TextBlock Text="{DynamicResource main.current_global_config}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- 键值列表由视图模型提供 -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentConfigRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top"
                                                       Foreground="#FF555555" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       FontFamily="Consolas"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 完整配置 -->
                            <DockPanel Grid.Row="2" Margin="0,14,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{DynamicResource main.refresh_list}" Command="{Binding RefreshConfigListCommand}"
                                            ToolTip="{DynamicResource tip.refresh_list}"/>
                                    <Button Content="{DynamicResource main.save_selected}" Command="{Binding SaveConfigItemCommand}"
                                            Style="{StaticResource SuccessButton}"
                                            ToolTip="{DynamicResource tip.save_selected}"/>
                                    <Button Content="{DynamicResource main.delete_selected}" Command="{Binding DeleteConfigItemCommand}"
                                            Style="{StaticResource DangerButton}"
                                            ToolTip="{DynamicResource tip.delete_selected}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource main.full_config}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <DataGrid Grid.Row="3"
                                      ItemsSource="{Binding ConfigItems}"
                                      SelectedItem="{Binding SelectedConfigItem}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      BorderBrush="#FFCCCCCC">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding FullKey}" IsReadOnly="True" Width="260">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource col.config_key}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource col.value}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Scope}" IsReadOnly="True" Width="80">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource col.scope}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 标签页2：GitHub CLI -->
            <TabItem Header="GitHub CLI">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{DynamicResource gh.refresh_status}" Command="{Binding RefreshGithubCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="{DynamicResource gh.login}" Command="{Binding LoginGithubCommand}" Style="{StaticResource SuccessButton}"
                                ToolTip="{DynamicResource tip.gh_login}"/>
                        <Button Content="{DynamicResource gh.switch_selected}" Command="{Binding SwitchGithubAccountCommand}" Style="{StaticResource SuccessButton}"
                                ToolTip="{DynamicResource tip.gh_switch_selected}"/>
                        <Button Content="{DynamicResource gh.logout_selected}" Command="{Binding LogoutGithubAccountCommand}" Style="{StaticResource DangerButton}"
                                ToolTip="{DynamicResource tip.gh_logout}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" ItemsSource="{Binding GithubAccounts}"
                                 SelectedItem="{Binding SelectedGithubAccount}"
                                 BorderBrush="#FFCCCCCC" Background="White" Margin="0,0,12,0">
                            <!-- 当前生效账号用绿色高亮 -->
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="ProfileListItem"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Host}" Foreground="#FF888888" FontSize="11"/>
                                            <TextBlock Text="{Binding Protocol}" Foreground="#FF666666" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 生效账号显示状态标记 -->
                                            <Button Content="{DynamicResource common.switch}" Style="{StaticResource SuccessButton}"
                                                    Margin="6,0,0,0" MinWidth="56"
                                                    Command="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsNotActive, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{DynamicResource tip.gh_switch_row}"/>
                                            <TextBlock Text="{DynamicResource gh.in_use}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Foreground="#FF107C10" FontWeight="SemiBold" FontSize="12"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{DynamicResource common.logout}" Style="{StaticResource DangerButton}"
                                                    Margin="6,0,0,0" MinWidth="56"
                                                    Command="{Binding DataContext.LogoutGithubAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource tip.gh_logout_row}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="1" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Padding="12">
                            <DockPanel>
                                <!-- 设备码授权面板 -->
                                <Border DockPanel.Dock="Top" Background="#FFFFF4CE" BorderBrush="#FFE8B93B"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                        Visibility="{Binding IsDeviceAuthVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{DynamicResource gh.device_auth_title}" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource gh.device_code}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding DeviceCodeText, Mode=OneWay}" IsReadOnly="True"
                                                     FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                     Width="130" Background="White" BorderBrush="#FFBFA32E"/>
                                            <Button Content="{DynamicResource gh.copy_device_code}" Command="{Binding CopyDeviceCodeCommand}"
                                                    Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                            <Button Content="{DynamicResource gh.open_auth_page}" Command="{Binding OpenGithubDevicePageCommand}"
                                                    Style="{StaticResource SuccessButton}" Margin="4,0,0,0"/>
                                            <Button Content="{DynamicResource gh.cancel_login}" Command="{Binding CancelLoginCommand}"
                                                    Style="{StaticResource DangerButton}" Margin="4,0,0,0"
                                                    ToolTip="{DynamicResource tip.gh_cancel_login}"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF7A5C00" Margin="0,8,0,0"
                                                   Text="{DynamicResource gh.device_auth_hint}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 命令记录：只读但可选中复制；颜色由代码后台按类型着色 -->
                                <RichTextBox x:Name="LogBox" IsReadOnly="True" IsDocumentEnabled="True"
                                             Background="#FF1E1E1E" Foreground="#FFE8E8E8"
                                             BorderThickness="0" Padding="8,6"
                                             FontFamily="Consolas" FontSize="12"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled">
                                    <FlowDocument x:Name="LogDocument"/>
                                </RichTextBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 标签页3：全局密钥配置 -->
            <TabItem Header="{DynamicResource ssh.title}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{DynamicResource common.refresh}" Command="{Binding RefreshSshCommand}"
                                Click="FlashSshList_Click"
                                ToolTip="{DynamicResource tip.ssh_refresh}"/>
                        <Button Content="{DynamicResource ssh.open_folder}" Command="{Binding OpenSshFolderCommand}"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="{DynamicResource tip.ssh_open_folder}"/>
                        <Button Content="{DynamicResource ssh.create_key}" Command="{Binding AddSshKeyCommand}"
                                ToolTip="{DynamicResource tip.ssh_create_key}"/>
                    </StackPanel>

                    <!-- SSH 目录路径，左键打开、右键复制 -->
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                               TextTrimming="CharacterEllipsis" Cursor="Hand">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSshFolderCommand}"/>
                            <MouseBinding MouseAction="RightClick" Command="{Binding CopySshPathCommand}"/>
                        </TextBlock.InputBindings>
                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="{Binding SshFolderPath, Mode=OneWay}"/><LineBreak/>
                                <Run Text="{DynamicResource tip.path_link_dir}" Foreground="#FF888888"/>
                            </TextBlock>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF888888"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF0078D4"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{DynamicResource ssh.folder_label}"/><Run Text="{Binding SshFolderPathDisplay, Mode=OneWay}"/>
                    </TextBlock>

                    <Border Grid.Row="2" Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="4" Padding="4">
                        <Grid>
                            <!-- 条目列表：签名白名单置顶，其后为各密钥 -->
                            <ListBox x:Name="SshEntryList"
                                     ItemsSource="{Binding SshEntries}"
                                     SelectedItem="{Binding SelectedSshEntry}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,7">
                                            <!-- 正常条目 -->
                                            <Grid x:Name="NormalRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- 文件名 + 类型徽章 -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                                   VerticalAlignment="Center"/>
                                                        <Border VerticalAlignment="Center" Margin="8,0,0,0"
                                                                BorderThickness="1" CornerRadius="10" Padding="8,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#FFE6F1FB"/>
                                                                    <Setter Property="BorderBrush" Value="#FF85B7EB"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWhitelist}" Value="True">
                                                                            <Setter Property="Background" Value="#FFFAEEDA"/>
                                                                            <Setter Property="BorderBrush" Value="#FFEF9F27"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#FF185FA5"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsWhitelist}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FF854F0B"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SummaryText}" Foreground="#FF888888"
                                                               FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- 行内操作按钮 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!-- 只有白名单行才有：比对密钥对与白名单 -->
                                                    <Button Content="{DynamicResource ssh.reconcile}" VerticalAlignment="Center"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding DataContext.ReconcileWhitelistCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="{DynamicResource tip.ssh_reconcile}"
                                                            Visibility="{Binding CanReconcile, Converter={StaticResource BoolToVis}}"/>

                                                    <Button Content="{DynamicResource common.preview}" VerticalAlignment="Center"
                                                            Style="{StaticResource SecondaryButton}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.PreviewSshEntryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="{DynamicResource tip.preview}"/>

                                                    <Button Content="{DynamicResource common.edit}" VerticalAlignment="Center"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.OpenSshEntryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="{DynamicResource tip.edit}"/>

                                                    <Button Content="{DynamicResource common.delete}" VerticalAlignment="Center"
                                                            Style="{StaticResource DangerButton}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.DeleteSshEntryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="{DynamicResource tip.delete}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 白名单文件不存在：占住同一个位置，放一个创建按钮 -->
                                            <Grid x:Name="WhitelistPlaceholderRow" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="#FFAAAAAA"/>
                                                    <TextBlock Text="{DynamicResource ssh.whitelist_missing}" FontSize="11"
                                                               Foreground="#FFAAAAAA" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center"
                                                        Content="{DynamicResource ssh.create_whitelist}"
                                                        Command="{Binding DataContext.CreateWhitelistFileCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ToolTip="{DynamicResource tip.create_whitelist}"/>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWhitelistPlaceholder}" Value="True">
                                                <Setter TargetName="NormalRow" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="WhitelistPlaceholderRow" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 没有密钥时的状态说明 -->
                            <TextBlock Text="{Binding SshStatusText}" FontSize="14" Foreground="#FF888888"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsSshListEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 标签页：关于 -->
            <TabItem Header="{DynamicResource tab.about}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AppVersionText}" Margin="0,4,0,16" Foreground="#FF666666"/>

                        <!-- 创作者：默认深灰，悬停变蓝并可点 -->
                        <TextBlock Margin="0,0,0,6">
                            <Run Text="{DynamicResource about.author}" Foreground="#FF444444"/>
                            <Hyperlink Click="OpenCreatorUrl_Click" TextDecorations="None"
                                       ToolTip="https://github.com/NeetheCheeBao">
                                <Run Text="NeetheCheeBao"/>
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Setter Property="Foreground" Value="#FF444444"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FF0078D4"/>
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                            </Hyperlink>
                        </TextBlock>

                        <!-- 项目地址 -->
                        <TextBlock Margin="0,0,0,20">
                            <Run Text="{DynamicResource about.project}" Foreground="#FF444444"/>
                            <Hyperlink Click="OpenProjectUrl_Click"
                                       Foreground="#FF0078D4" TextDecorations="None"
                                       ToolTip="https://github.com/NeetheCheeBao/GitConfigTool">
                                <Run Text="https://github.com/NeetheCheeBao/GitConfigTool"/>
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                            </Hyperlink>
                        </TextBlock>

                        <!-- 本机信息：只读文本框，可整段复制，也可自由划选 -->
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource common.copy}" Padding="12,3" FontSize="12"
                                    Command="{Binding CopyEnvironmentCommand}"
                                    ToolTip="{DynamicResource tip.copy_env}"/>
                            <TextBlock Text="{DynamicResource about.local_info}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Background="White" BorderBrush="#FFCCCCCC" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,20">
                            <TextBox Text="{Binding EnvironmentText, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="14,12" Margin="0"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </Border>

                        <Button Content="{DynamicResource about.check_update}" HorizontalAlignment="Left"
                                Click="CheckUpdate_Click"
                                ToolTip="{DynamicResource tip.check_update}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#FF2D2D30" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFCCCCCC" VerticalAlignment="Center"/>
                <!-- 鼠标悬停显示探测到的真实路径 -->
                <TextBlock Grid.Column="1" Foreground="#FF888888" VerticalAlignment="Center" Margin="0,0,16,0"
                           ToolTip="{Binding GitPath, Mode=OneWay}">
                    <Run Text="Git: "/><Run Text="{Binding GitVersion, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Grid.Column="2" Foreground="#FF888888" VerticalAlignment="Center"
                           ToolTip="{Binding GhPath, Mode=OneWay}">
                    <Run Text="gh: "/><Run Text="{Binding GhVersion, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
